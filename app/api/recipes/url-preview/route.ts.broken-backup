    let instructions = normalizeInstructions(recipeNode?.recipeInstructions);

    const candidateText = extractRecipeCandidateText(html);

    if (!ingredients.length && !instructions.length && candidateText) {
      const sectionParsed = parseSectionsFromText(candidateText);

      if (!ingredients.length) {
        ingredients = humanizeIngredientLines(sectionParsed.ingredients || []);
      }
      if (!instructions.length) {
        instructions = sectionParsed.instructions || [];
      }
      if ((!rawTitle || rawTitle.startsWith("Clipped recipe")) && sectionParsed.title) {
        rawTitle = sectionParsed.title;
      }
    }

    let aiUsed = false;

    if ((!ingredients.length || !instructions.length) && candidateText) {
      const ai = await aiExtractRecipeFromText(candidateText, url, host);

      if (ai) {
        if ((!rawTitle || rawTitle.startsWith("Clipped recipe")) && ai.title) {
          rawTitle = ai.title;
        }
        if (!rawDescription && ai.description) {
          rawDescription = ai.description;
        }
        if (!ingredients.length && ai.ingredients.length) {
          ingredients = ai.ingredients;
          aiUsed = true;
        }
        if (!instructions.length && ai.instructions.length) {
          instructions = ai.instructions;
          aiUsed = true;
        }
      }
    }

    const bothFailed =
