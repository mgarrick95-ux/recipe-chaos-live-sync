    if (!ingredients.length && !instructions.length && bothFailed) {
      const blockedResult = makeBlockedResult(
        url,
        host,
        direct.status,
        fallback ? fallback.status : null
      );
      return NextResponse.json(blockedResult, { status: 200 });
    }

    if (!ingredients.length && !instructions.length) {
      return NextResponse.json(
        {
          error:
            "Could not extract recipe data from that URL. The site may block scraping or hide recipe content. You can still use Manual or Photo.",
        },
        { status: 400 }
      );
    }

    const review: PreviewResult["review"] = {
      title: recipeNode?.name
        ? "imported"
        : aiUsed
        ? "inferred"
        : "cleaned",
      description: recipeNode?.description
        ? "imported"
        : rawDescription
        ? aiUsed
          ? "inferred"
          : "cleaned"
        : "missing",
      ingredients: recipeNode?.recipeIngredient
        ? "imported"
        : ingredients.length
        ? aiUsed
          ? "inferred"
          : "cleaned"
        : "missing",
      instructions: recipeNode?.recipeInstructions
        ? "imported"
        : instructions.length
        ? aiUsed
          ? "inferred"
          : "cleaned"
        : "missing",
    };

    const warnings: string[] = [];
    const notes: string[] = [];

    if (!ingredients.length) warnings.push("No ingredients were found.");
    if (!instructions.length) warnings.push("No instructions were found.");

    if (!recipeNode && usedMode === "fallback" && !aiUsed) {
      notes.push(
        "Recipe content was inferred from page text because structured recipe data was not available."
      );
    }

    if (aiUsed) {
      notes.push(
        "Some recipe fields were inferred from page text using AI because structured recipe data was incomplete or unavailable."
      );
    }

    const out: PreviewResult = {
      title: cleanTitle(rawTitle, host),
      description: cleanDescription(rawDescription),
      ingredients,
      instructions,
      source_url: url,
      source_name: host,
      source_text: null,
      review,
      warnings,
      notes,
    };

    return NextResponse.json(out);
  } catch (e: any) {
    return NextResponse.json(
      { error: e?.message || "Preview failed" },
      { status: 500 }
    );
  }
}
